{
  "name": "metacubexd-monorepo",
  "version": "1.271.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "pnpm dev:ui",
    "dev:ui": "pnpm --filter @metacubexd/ui dev",
    "dev:server": "pnpm build:ui && pnpm --filter @metacubexd/server dev",
    "dev:desktop": "pnpm --filter @metacubexd/desktop fetch:mihomo && pnpm --filter @metacubexd/desktop ensure:electron && node vendor/metacubexd/apps/desktop/scripts/dev-desktop.mjs",
    "dev:desktop:deno": "pnpm --filter @metacubexd/ui generate:desktop && pnpm --filter @meow/desktop-deno fetch:mihomo && pnpm --filter @meow/desktop-deno dev",
    "build:ui": "pnpm --filter @metacubexd/ui generate",
    "generate": "pnpm build:ui && rm -rf .output && cp -r vendor/metacubexd/packages/ui/.output .output",
    "build:server": "pnpm --filter @metacubexd/server... build",
    "build:desktop": "pnpm --filter @metacubexd/desktop... build",
    "build:desktop:deno": "pnpm --filter @meow/desktop-deno build",
    "build": "pnpm build:ui && pnpm build:server",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "prepare:husky": "husky",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "commitlint": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "lint-staged": "catalog:"
  },
  "workspaces": [
    "apps/*",
    "vendor/metacubexd/apps/*",
    "vendor/metacubexd/packages/*"
  ],
  "catalog": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/fuses": "^2.1.3",
    "@floating-ui/vue": "^2.0.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/i18n": "^10.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.1",
    "@playwright/test": "^1.62.0",
    "@prettier/plugin-oxc": "^0.2.2",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-virtual": "^3.13.35",
    "@types/byte-size": "^8.1.2",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "byte-size": "^9.0.1",
    "commitlint": "^21.2.1",
    "d3": "^7.9.0",
    "daisyui": "^5.7.4",
    "dayjs": "^1.11.21",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "h3": "^1.15.11",
    "highcharts": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "ky": "^2.0.2",
    "lint-staged": "^17.2.0",
    "markdown-it": "^14.3.0",
    "match-sorter": "^8.3.0",
    "meta-json-schema": "^1.19.29",
    "monaco-editor": "0.52.2",
    "monaco-yaml": "^5.5.1",
    "nitropack": "^2.12.6",
    "nuxt": "4.5.1",
    "pinia": "^4.0.2",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sort-package-json": "^4.0.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "tree-kill": "^1.2.2",
    "tsx": "^4.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uqr": "^0.1.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.8",
    "yaml": "^2.9.0"
  }
}
